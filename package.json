{
  "name": "convert-api",
  "version": "1.0.0",
  "description": "API for converting between XML, JSON, and YAML formats",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=cjs --target=node18 --banner:js=\"#!/usr/bin/env node\" --outfile=bin/mcp-server.js",
    "test": "jest",
    "package": "npm run build && npm ci --omit=dev && zip -r lambda-deployment.zip dist/ node_modules/ && npm ci"
  },
  "keywords": ["api", "conversion", "xml", "json", "yaml", "aws", "lambda"],
  "author": "Ryo Hasegawa",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "js-yaml": "5.2.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
